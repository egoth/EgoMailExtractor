{
  "schema_version": 7,
  "name": "Vrbo - soggiorni",
  "description": "Profilo iniziale per prenotazioni e ricevute deposito Vrbo, riconciliate tramite Numero Prenotazione/Numero di riferimento.",
  "fields": [
    {
      "name": "id_soggiorno",
      "type": "text"
    },
    {
      "name": "nome_annuncio",
      "type": "text"
    },
    {
      "name": "data_check_in",
      "type": "date"
    },
    {
      "name": "data_check_out",
      "type": "date"
    },
    {
      "name": "durata_giorni",
      "type": "number"
    },
    {
      "name": "nome_ospite",
      "type": "text"
    },
    {
      "name": "numero_ospiti",
      "type": "number"
    },
    {
      "name": "importo_pagato_ospite",
      "type": "number",
      "format": "currency_eur"
    },
    {
      "name": "tasse_pagate",
      "type": "number",
      "format": "currency_eur"
    },
    {
      "name": "importo_ricevuto",
      "type": "number",
      "format": "currency_eur"
    }
  ],
  "reconcile_keys": [
    "id_soggiorno"
  ],
  "computed_fields": [
    {
      "field": "durata_giorni",
      "kind": "days_between",
      "start_field": "data_check_in",
      "end_field": "data_check_out",
      "priority": "rule_wins"
    }
  ],
  "mail_types": [
    {
      "name": "prenotazione_vrbo",
      "rules": [
        {
          "name": "numero_prenotazione",
          "field": "id_soggiorno",
          "source": "body",
          "strategy": "regex",
          "pattern": "Numero Prenotazione\\s+(HA-[A-Z0-9]+)",
          "group": 1,
          "transform": "upper",
          "existing_value_policy": "replace"
        },
        {
          "name": "numero_annuncio",
          "field": "nome_annuncio",
          "source": "body",
          "strategy": "regex",
          "pattern": "Proprietà\\s+#?(\\d{6,})",
          "group": 1,
          "transform": "text",
          "existing_value_policy": "replace"
        },
        {
          "name": "date_checkin",
          "field": "data_check_in",
          "source": "body",
          "strategy": "regex",
          "pattern": "Date\\s+(\\d{1,2}\\s+[A-Za-zàèéìòù]+)(?:\\s*-)",
          "group": 1,
          "transform": "date_it_email_year",
          "existing_value_policy": "replace"
        },
        {
          "name": "date_checkout",
          "field": "data_check_out",
          "source": "body",
          "strategy": "regex",
          "pattern": "Date\\s+\\d{1,2}\\s+[A-Za-zàèéìòù]+\\s*-\\s*(\\d{1,2}\\s+[A-Za-zàèéìòù]+\\s+\\d{4})",
          "group": 1,
          "transform": "date_it_email_year",
          "existing_value_policy": "replace"
        },
        {
          "name": "ospiti",
          "field": "numero_ospiti",
          "source": "body",
          "strategy": "regex",
          "pattern": "Ospiti\\s+([^\\n]+)",
          "group": 1,
          "transform": "guest_count",
          "existing_value_policy": "replace"
        },
        {
          "name": "nome_viaggiatore",
          "field": "nome_ospite",
          "source": "body",
          "strategy": "regex",
          "pattern": "Nome del viaggiatore\\s+([^\\n]+)",
          "group": 1,
          "transform": "text",
          "existing_value_policy": "replace"
        }
      ],
      "match_rules": [
        {
          "name": "match_subject_1",
          "source": "subject",
          "mode": "regex",
          "trigger": "Prenotazione per .*Vrbo"
        }
      ]
    },
    {
      "name": "deposito_vrbo",
      "rules": [
        {
          "name": "riferimento_prenotazione",
          "field": "id_soggiorno",
          "source": "body",
          "strategy": "regex",
          "pattern": "(HA-[A-Z0-9]+)\\s+OWNER_RENT\\s+([0-9.]+,[0-9]{2})\\s*€",
          "group": 1,
          "transform": "upper",
          "existing_value_policy": "replace"
        },
        {
          "name": "importo_owner_rent",
          "field": "importo_ricevuto",
          "source": "body",
          "strategy": "regex",
          "pattern": "HA-[A-Z0-9]+\\s+OWNER_RENT\\s+([0-9.]+,[0-9]{2})\\s*€",
          "group": 1,
          "transform": "money",
          "existing_value_policy": "replace"
        }
      ],
      "match_rules": [
        {
          "name": "match_subject_1",
          "source": "subject",
          "mode": "regex",
          "trigger": "Pagamenti online.*Vrbo.*Ricevuta del deposito"
        }
      ]
    }
  ],
  "state": {
    "folder": "INBOX",
    "uidvalidity": 0,
    "last_processed_uid": 0,
    "last_processed_at": ""
  }
}
