{
  "schema_version": 7,
  "name": "Airbnb - soggiorni",
  "description": "Profilo iniziale per riconciliare promemoria/prenotazioni Airbnb con le successive email di pagamento usando il codice di conferma.",
  "fields": [
    {
      "name": "id_soggiorno",
      "type": "text"
    },
    {
      "name": "nome_annuncio",
      "type": "text"
    },
    {
      "name": "data_check_in",
      "type": "date"
    },
    {
      "name": "data_check_out",
      "type": "date"
    },
    {
      "name": "durata_giorni",
      "type": "number"
    },
    {
      "name": "nome_ospite",
      "type": "text"
    },
    {
      "name": "numero_ospiti",
      "type": "number"
    },
    {
      "name": "importo_pagato_ospite",
      "type": "number",
      "format": "currency_eur"
    },
    {
      "name": "tasse_pagate",
      "type": "number",
      "format": "currency_eur"
    },
    {
      "name": "importo_ricevuto",
      "type": "number",
      "format": "currency_eur"
    }
  ],
  "reconcile_keys": [
    "id_soggiorno"
  ],
  "computed_fields": [
    {
      "field": "durata_giorni",
      "kind": "days_between",
      "start_field": "data_check_in",
      "end_field": "data_check_out",
      "priority": "rule_wins"
    }
  ],
  "mail_types": [
    {
      "name": "promemoria_prenotazione",
      "description": "Promemoria/riassunto della prenotazione prima dell'arrivo",
      "rules": [
        {
          "name": "codice_conferma",
          "field": "id_soggiorno",
          "source": "body",
          "strategy": "regex",
          "pattern": "Codice di conferma\\s+([A-Z0-9]{8,})",
          "group": 1,
          "transform": "upper",
          "existing_value_policy": "replace"
        },
        {
          "name": "nome_ospite_da_oggetto",
          "field": "nome_ospite",
          "source": "subject",
          "strategy": "regex",
          "pattern": "Promemoria di prenotazione:\\s*(.+?)\\s+arriverà presto",
          "group": 1,
          "transform": "text",
          "existing_value_policy": "replace"
        },
        {
          "name": "nome_ospite_completo_da_corpo",
          "field": "nome_ospite",
          "source": "body",
          "strategy": "regex",
          "pattern": "arriverà[^\\n]*\\n+([A-ZÀ-ÖØ-Ý][^\\n]{2,80})",
          "group": 1,
          "transform": "text",
          "existing_value_policy": "replace"
        },
        {
          "name": "nome_annuncio",
          "field": "nome_annuncio",
          "source": "body",
          "strategy": "regex",
          "pattern": "(?:^|\\n)([^\\n]+)\\n+Intera casa/appart\\.",
          "group": 1,
          "transform": "text",
          "existing_value_policy": "replace"
        },
        {
          "name": "check_in",
          "field": "data_check_in",
          "source": "body",
          "strategy": "regex",
          "pattern": "Check-in\\s+(?:lun|mar|mer|gio|ven|sab|dom)?\\s*(\\d{1,2}\\s+[A-Za-zàèéìòù]+(?:\\s+\\d{4})?)",
          "group": 1,
          "transform": "date_it_email_year",
          "existing_value_policy": "replace"
        },
        {
          "name": "check_out",
          "field": "data_check_out",
          "source": "body",
          "strategy": "regex",
          "pattern": "Check-out\\s+(?:lun|mar|mer|gio|ven|sab|dom)?\\s*(\\d{1,2}\\s+[A-Za-zàèéìòù]+(?:\\s+\\d{4})?)",
          "group": 1,
          "transform": "date_it_email_year",
          "existing_value_policy": "replace"
        },
        {
          "name": "numero_ospiti",
          "field": "numero_ospiti",
          "source": "body",
          "strategy": "regex",
          "pattern": "Ospiti\\s+([^\\n]+)",
          "group": 1,
          "transform": "guest_count",
          "existing_value_policy": "replace"
        },
        {
          "name": "totale_pagato_ospite",
          "field": "importo_pagato_ospite",
          "source": "body",
          "strategy": "regex",
          "pattern": "Totale \\(EUR\\)\\s+([0-9.]+,[0-9]{2})\\s*€",
          "group": 1,
          "transform": "money",
          "existing_value_policy": "replace"
        },
        {
          "name": "tasse_soggiorno",
          "field": "tasse_pagate",
          "source": "body",
          "strategy": "regex",
          "pattern": "Tasse di soggiorno\\s+([0-9.]+,[0-9]{2})\\s*€",
          "group": 1,
          "transform": "money",
          "existing_value_policy": "replace"
        }
      ],
      "match_rules": [
        {
          "name": "match_subject_1",
          "source": "subject",
          "mode": "regex",
          "trigger": "Promemoria di prenotazione:.*arriverà presto"
        }
      ]
    },
    {
      "name": "pagamento_compenso",
      "description": "Email Airbnb che conferma l'invio del compenso netto",
      "rules": [
        {
          "name": "id_soggiorno_da_dettagli",
          "field": "id_soggiorno",
          "source": "body",
          "strategy": "regex",
          "pattern": "\\(\\d+\\)\\s+([A-Z0-9]{8,})",
          "group": 1,
          "transform": "upper",
          "occurrence": -1,
          "existing_value_policy": "replace"
        },
        {
          "name": "importo_ricevuto_da_oggetto",
          "field": "importo_ricevuto",
          "source": "subject",
          "strategy": "regex",
          "pattern": "compenso di\\s*([0-9.]+,[0-9]{2})\\s*€",
          "group": 1,
          "transform": "money",
          "existing_value_policy": "replace"
        }
      ],
      "match_rules": [
        {
          "name": "match_subject_1",
          "source": "subject",
          "mode": "regex",
          "trigger": "Abbiamo inviato un compenso di"
        }
      ]
    }
  ],
  "state": {
    "folder": "INBOX",
    "uidvalidity": 0,
    "last_processed_uid": 0,
    "last_processed_at": ""
  }
}
